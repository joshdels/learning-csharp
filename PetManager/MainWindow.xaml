<Window x:Class="PetManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pet Manager"
        Width="400"
        Height="300">

    <StackPanel Margin="30">

        <TextBlock Text="Pet Manager"
                   FontSize="28"
                   Margin="0,0,0,20"/>

        <TextBlock Text="Pet Name"/>

        <TextBox x:Name="NameBox"
                 Margin="0,5,0,10"/>

        <TextBlock Text="Species"/>

        <TextBox x:Name="SpeciesBox"
                 Margin="0,5,0,10"/>

        <Button Content="Add Pet"
                Height="35"
                Click="AddPet_Click"/>

    </StackPanel>

</Window>